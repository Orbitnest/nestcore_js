{
  "name": "@nestcorehq/js",
  "version": "0.9.0",
  "description": "NestCore JavaScript/TypeScript SDK for the browser — auth, database, query builder, storage, realtime, edge functions.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nestcore",
    "sdk",
    "browser",
    "supabase-alternative",
    "database",
    "auth",
    "realtime",
    "backend-as-a-service"
  ],
  "author": "NestCore",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orbitnest/nestcore_js.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
